<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cottage Temperature Monitor</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.js"></script>
    <link rel="icon" type="image/png" href="icon.png">                                                                                                                                   
</head>
<body>
    <div class="flex" style="margin-bottom: 15px;">
        <img height="48px" src="icon.png"/>
        <h1>Cottage Temperature Monitor</h1>
    </div>
    <div class="flex">
        <div class="number-container">
            <h2>Temperature</h2>
            <h3 id="current"><%= temperature %>°C</h3>
        </div>

        <div class="number-container">
            <h2>Daily low</h2>
            <h3 id="low"><%= low %>°C</h3>
        </div>
    </div>

    <div class="chart-container">
        <h2>Hourly Temperatures</h2>
        <canvas id="hourlyChart"></canvas>
        <p id="no_data">No data to show</p>
    </div>

    <div class="chart-container">
        <h2>Daily Temperatures</h2>
        <canvas id="dailyChart"></canvas>
        <p id="no_data">No data to show</p>
    </div>

</body>
<script>
    const dailyRows = <%- JSON.stringify(dailyData) %>
    const hourlyRows = <%- JSON.stringify(hourlyData) %>
    let low = Number(<%- JSON.stringify(low) %>);
</script>
<script src="/main.js"></script>
</html>